{
  "schema": "med-source-registry",
  "sources": [
    {
      "id": "pubmed",
      "provider": "NCBI / U.S. National Library of Medicine",
      "type": "biomedical_publications",
      "endpoint": "https://eutils.ncbi.nlm.nih.gov/entrez/eutils/",
      "status": "connected",
      "access": "public_metadata_only",
      "personal_data": false
    },
    {
      "id": "clinicaltrials",
      "provider": "ClinicalTrials.gov",
      "type": "clinical_studies",
      "endpoint": "https://clinicaltrials.gov/api/v2/studies",
      "status": "connected",
      "access": "public_metadata_only",
      "personal_data": false,
      "adapter": "clinical_trials.py",
      "notes": "Adapter implemented; deployment/network tests pending"
    },
    {
      "id": "icd11",
      "provider": "WHO",
      "type": "diagnosis_classification",
      "endpoint": "https://id.who.int/",
      "status": "candidate",
      "access": "oauth2_credentials_required",
      "personal_data": false,
      "documentation": "https://icd.who.int/docs/icd-api/APIDoc-Version2/"
    },
    {
      "id": "clinical_guidelines",
      "provider": "to_be_selected",
      "type": "clinical_guideline_documents",
      "endpoint": null,
      "status": "requires_source",
      "access": "jurisdiction_and_license_pending",
      "personal_data": false
    }
  ],
  "ingestion_policy": {
    "query_scope": "public_non_patient_research_only",
    "results_per_query_max": 10,
    "persist_patient_data": false,
    "source_evidence_required": true
  }
}
